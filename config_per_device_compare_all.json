{
  "test_name": "per_device_and_aggregate_all",
  "devices": {
    "pci_addresses": ["0000:50:00.0", "0000:41:00.0", "0000:51:00.0", "0000:44:00.0"],
    "format_before_test": true,
    "use_raid": false,
    "raid_chunk_size": "64K"
  },
  "execution": {
    "run_aggregate": true,
    "run_per_device": true,
    "prepare_mode": "once",
    "comparison_summary": {
      "best_points": true,
      "fixed_points": [
        {
          "name": "16k_read",
          "workload": "read",
          "block_size": "16K",
          "numjobs": 16,
          "iodepth": 64
        },
        {
          "name": "16k_write",
          "workload": "write",
          "block_size": "16K",
          "numjobs": 16,
          "iodepth": 64
        },
        {
          "name": "512k_read",
          "workload": "read",
          "block_size": "512K",
          "numjobs": 16,
          "iodepth": 64
        },
        {
          "name": "512k_write",
          "workload": "write",
          "block_size": "512K",
          "numjobs": 16,
          "iodepth": 64
        }
      ]
    }
  },
  "fio": {
    "block_sizes": ["16K", "512K"],
    "numjobs": [16],
    "iodepth": [256],
    "workloads": ["read", "write"],
    "runtime": 30,
    "ramp_time": 10,
    "direct": 1,
    "ioengine": "libaio",
    "size": "100%"
  },
  "output": {
    "base_dir": "./output",
    "plot_format": "png"
  }
}
