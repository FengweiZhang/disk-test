{
  "test_name": "per_device_and_aggregate",
  "devices": {
    "pci_addresses": ["0000:50:00.0", "0000:51:00.0"],
    "format_before_test": true,
    "use_raid": false,
    "raid_chunk_size": "64K"
  },
  "execution": {
    "run_aggregate": true,
    "run_per_device": true,
    "prepare_mode": "once",
    "comparison_summary": {
      "best_points": true,
      "fixed_points": [
        {
          "name": "4k_randread_hot",
          "workload": "randread",
          "block_size": "4K",
          "numjobs": 4,
          "iodepth": 64
        }
      ]
    }
  },
  "fio": {
    "block_sizes": ["4K", "64K"],
    "numjobs": [1, 4],
    "iodepth": [1, 64],
    "workloads": ["read", "randread"],
    "runtime": 5,
    "ramp_time": 2,
    "direct": 1,
    "ioengine": "libaio",
    "size": "100%"
  },
  "output": {
    "base_dir": "./output",
    "plot_format": "png"
  }
}
